FROM frontiercs/vllm-serving-optimization-judge:experimental-v0.11.1

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 ca-certificates  bash ca-certificates curl git python3 python3-pip && \
    pip3 install --break-system-packages modal openai datasets huggingface-hub rank-bm25 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /judge

COPY judge_server.py problem_evaluator.py task_config.json /judge/
RUN chmod 600 /judge/problem_evaluator.py

EXPOSE 8082
CMD ["python3", "/judge/judge_server.py"]
