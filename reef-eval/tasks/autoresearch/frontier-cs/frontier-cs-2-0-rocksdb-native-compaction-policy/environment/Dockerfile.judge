FROM frontiercs/rocksdb-native-compaction-judge:experimental-v10.10.1-task2

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 ca-certificates  && \
    : && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /judge

COPY judge_server.py problem_evaluator.py task_config.json /judge/
RUN chmod 600 /judge/problem_evaluator.py

EXPOSE 8082
CMD ["python3", "/judge/judge_server.py"]
