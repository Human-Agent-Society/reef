{
  "target": "primary",
  "data": {
    "permissions": {
      "allow": ["Bash(reef-claude *)"]
    },
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup|resume",
          "hooks": [
            {
              "type": "command",
              "command": "if [ -n \"$REEF_HARNESS_WRAPPER\" ]; then \"$REEF_HARNESS_WRAPPER\" notice --hook claude; fi"
            }
          ]
        }
      ]
    }
  }
}
